# Application
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-site.onrender.com
NEXT_PUBLIC_SITE_NAME=Winnie Awuor Otieno — Accounting & Tax

# Database (Supabase PostgreSQL)
# Use the pooled connection string on Render:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# The session pooler (port 5432) works too. The direct connection
# (db.<project-ref>.supabase.co:5432) is only used from IPv4 networks.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require
# The pool is small on purpose: Supabase reserves connections for the pooler.
DATABASE_POOL_SIZE=5

# Supabase Storage (production uploads)
# The service-role key stays on the server. Never use a NEXT_PUBLIC_ variable
# for it, and never put it in the browser bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLIC_BUCKET=portfolio-public
SUPABASE_PRIVATE_BUCKET=portfolio-private

# File storage
# Only used when Supabase is not configured (local development). Files are
# written here and served by the application.
MEDIA_DIR=data/uploads
MEDIA_BASE_URL=/api/media

# S3-compatible object storage (optional alternative to Supabase Storage).
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=winnies-portfolio
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Authentication
# At least 32 random characters. Changing it invalidates sealed passwords.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_MAX_AGE=604800

# First administrator one-time setup (only used when no administrator exists yet).
# ADMIN_SETUP_TOKEN must match the token passed to /api/admin/setup.
ADMIN_SETUP_TOKEN=replace-with-a-strong-random-token
# ADMIN_EMAIL=winnie@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password

# Login protection
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=900000

# Contact form (optional). When SMTP details are provided, inquiries are also
# emailed to the configured address. Otherwise inquiries are stored in the database
# and visible only to administrators.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# CONTACT_EMAIL=winnie@example.com
