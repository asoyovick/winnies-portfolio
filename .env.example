# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Winnie Awuor Otieno — Accounting & Tax

# File storage
# Uploaded files (profile pictures, documents) are written to this directory.
# It is created automatically on first upload. In development it can live
# inside the project; in production it must be on a persistent volume.
#
#   data/uploads/
#     profile/<generated-name>.png   Winnie's profile picture
#     <generated-name>.pdf           other uploads
MEDIA_DIR=data/uploads

# The public path the stored files are served from. Keep it as a path, not an
# absolute filesystem location.
MEDIA_BASE_URL=/api/media

# Production object storage (optional). When these are set, uploads go to S3
# compatible storage instead of the local filesystem, using the same folder
# layout. Keep secrets out of version control — provide them via your hosting
# provider's environment variables.
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=winnies-portfolio
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Authentication
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_MAX_AGE=604800

# First administrator one-time setup (only used when no administrator exists yet).
# ADMIN_SETUP_TOKEN must match the token passed to /api/admin/setup.
ADMIN_SETUP_TOKEN=replace-with-a-strong-random-token
# ADMIN_EMAIL=winnie@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password

# Contact form (optional). When SMTP details are provided, inquiries are also
# emailed to the configured address. Otherwise inquiries are stored in the database
# and visible only to administrators.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# CONTACT_EMAIL=winnie@example.com
